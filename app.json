{
    "expo": {
      "name": "Electrician Helper",
      "slug": "electrician-helper",
      "owner": "masudrana1251996",
      "version": "1.0.0",
      "orientation": "portrait",
      "icon": "./assets/images/icon.png",
      "scheme": "electrician-helper",
      "userInterfaceStyle": "dark",
      "newArchEnabled": true,
      "splash": {
        "image": "./assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0A0A"
      },
      "ios": {
        "supportsTablet": false
      },
      "android": {
        "backgroundColor": "#0A0A0A",
        "package": "com.devteampro.electricianhelper",
        "versionCode": 1,
        "adaptiveIcon": {
          "foregroundImage": "./assets/images/icon.png",
          "backgroundColor": "#0A0A0A"
        }
      },
      "web": {
        "favicon": "./assets/images/icon.png"
      },
      "plugins": [
        ["expo-router", { "origin": "https://replit.com/" }],
        "expo-font",
        "expo-web-browser"
      ],
      "experiments": {
        "typedRoutes": true,
        "reactCompiler": true
      }
    }
  }